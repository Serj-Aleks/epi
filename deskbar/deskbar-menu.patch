+void
+TDeskbarMenu::_AddTopFolders(bool dragging)
+{
+	BPath path;
+	if (GetDeskbarSettingsDirectory(path) != B_OK
+		|| path.Append("menu_top") != B_OK)
+		return;
+
+	BDirectory dir(path.Path());
+	if (dir.InitCheck() != B_OK)
+		return;
+
+	BStringList names;
+	BEntry entry;
+	while (dir.GetNextEntry(&entry) == B_OK) {
+		char name[B_FILE_NAME_LENGTH];
+		if (entry.IsDirectory() && entry.GetName(name) == B_OK)
+			names.Add(name);
+	}
+	names.Sort();
+
+	TrackingHookData* data = fBarView != NULL
+		? fBarView->GetTrackingHookData() : NULL;
+	BMessage message(B_REFS_RECEIVED);
+	for (int32 i = 0; i < names.CountStrings(); i++) {
+		if (dir.FindEntry(names.StringAt(i).String(), &entry) != B_OK)
+			continue;
+		Model model(&entry);
+		if (model.InitCheck() != B_OK)
+			continue;
+		ModelMenuItem* item = BNavMenu::NewModelItem(&model, &message,
+			Target(), false, NULL, TypesList(),
+			dragging ? data : NULL);
+		if (item != NULL)
+			AddItem(item);
+	}
+}
