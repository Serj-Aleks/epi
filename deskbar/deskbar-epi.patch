+// EPI: an application shown in Deskbar carries the name of its link in the
+// EPI menu (~/config/settings/deskbar/menu_entries and menu_top), so the menu
+// and the bar speak one terminology. Returns false if the app is not there.
+static bool
+_EpiNameIn(const char* dirPath, const BPath& appPath, BString& name, int depth)
+{
+	BDirectory dir(dirPath);
+	if (dir.InitCheck() != B_OK)
+		return false;
+
+	BEntry entry;
+	while (dir.GetNextEntry(&entry) == B_OK) {
+		BPath path;
+		if (entry.GetPath(&path) != B_OK)
+			continue;
+		if (entry.IsSymLink()) {
+			BEntry target(path.Path(), true);
+			BPath targetPath;
+			if (target.GetPath(&targetPath) == B_OK
+				&& targetPath == appPath) {
+				name = path.Leaf();
+				return true;
+			}
+		} else if (entry.IsDirectory() && depth > 0) {
+			if (_EpiNameIn(path.Path(), appPath, name, depth - 1))
+				return true;
+		}
+	}
+	return false;
+}
+
+
+bool
+TBarApp::_EpiName(const entry_ref& ref, BString& name)
+{
+	BEntry appEntry(&ref, true);
+	BPath appPath;
+	BPath settings;
+	if (appEntry.GetPath(&appPath) != B_OK
+		|| GetDeskbarSettingsDirectory(settings) != B_OK)
+		return false;
+
+	const char* const kMenuDirs[] = { "menu_top", "menu_entries" };
+	for (int32 i = 0; i < 2; i++) {
+		BPath dir(settings);
+		if (dir.Append(kMenuDirs[i]) == B_OK
+			&& _EpiNameIn(dir.Path(), appPath, name, 3))
+			return true;
+	}
+	return false;
+}
