#!/bin/sh
# EPI: сторож сети. Заменяет epi-wifi.
# Следит за Wi-Fi всё время. Журнал 25.10 показал: собственная попытка Haiku
# при загрузке за 26 с не подключает, а команда join подключает за 4-6 с.
# Поэтому: при загрузке ждём Haiku 5 с, после обрыва 10 с, затем join и до 30 с
# на подключение; пока интерфейс получает адрес (configuring), не вмешиваемся.
# Неудача — пауза 1, 2, 4, 5 мин (не долбить роутер). Не сдаётся.
# Журнал: ~/config/var/log/epi-net.log (каждое событие со временем).
conf=/boot/system/settings/network/wireless_networks
logdir=$HOME/config/var/log
log=$logdir/epi-net.log
mkdir -p "$logdir"

# один экземпляр (/tmp очищается при загрузке)
lock=/tmp/epi-net.pid
if [ -f "$lock" ] && kill -0 "$(cat "$lock")" 2>/dev/null; then exit 0; fi
echo $$ > "$lock"

say() {
	[ -f "$log" ] && [ "$(wc -c < "$log")" -gt 262144 ] && mv "$log" "$log.1"
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$log"
}
nets() { [ -f "$conf" ] && sed -n 's/^network[[:space:]]\{1,\}\(.*[^[:space:]]\)[[:space:]]*{$/\1/p' "$conf"; }
connected() { ifconfig "$1" 2>/dev/null | grep -q 'Network:'; }
where() { ifconfig "$1" 2>/dev/null | grep -E 'Network:|inet addr:' | sed 's/^[[:space:]]*//' | tr '\n' ' '; }
seen() { ifconfig "$1" list 2>/dev/null | tail -n +2 | awk '{printf "%s ", $0}'; }
# Строка Network: на мгновение пропадает и при живой связи (фоновое сканирование
# драйвера), поэтому обрыв засчитывается, только если связи нет 3 проверки за 5 с.
steady() { connected "$1" || { sleep 2; connected "$1"; } || { sleep 3; connected "$1"; }; }
wait_link() { i=0; while [ $i -lt "$2" ]; do connected "$1" && return 0; sleep 1; i=$((i+1)); done; return 1; }

# При загрузке драйвер Wi-Fi может подняться позже сторожа: ждём его, не выходим.
devs=""
said=""
while [ -z "$devs" ]; do
	for d in /dev/net/*/0; do
		ifconfig "$d" list >/dev/null 2>&1 && devs="$devs $d"
	done
	if [ -z "$devs" ]; then
		[ -z "$said" ] && say "Wi-Fi устройство ещё не готово, жду" && said=1
		sleep 5
	fi
done
say "старт, устройства:$devs"

state=boot
pause=60
while :; do
	for d in $devs; do
		# при загрузке без перепроверок: обрыва ещё не было, ложной тревоги нет
		if { [ "$state" = boot ] && connected "$d"; } \
			|| { [ "$state" != boot ] && steady "$d"; }; then
			[ "$state" != up ] && say "есть связь: $(where "$d")"
			state=up; pause=60
			continue
		fi
		if [ "$state" = up ]; then
			say "обрыв связи"
		fi
		if [ "$state" != down ]; then
			# даём Haiku его собственную попытку
			[ "$state" = boot ] && grace=5 || grace=10
			state=down
			wait_link "$d" $grace && continue
		fi
		# Haiku ещё подключается (получает адрес) — не мешаем
		if ifconfig "$d" 2>/dev/null | grep -q configuring; then
			sleep 10; continue
		fi
		say "видно: $(seen "$d")"
		for n in $(nets | tr ' ' '\037'); do
			n=$(echo "$n" | tr '\037' ' ')
			say "подключаю: $n"
			ifconfig "$d" join "$n" >/dev/null 2>&1
			if wait_link "$d" 30; then
				say "есть связь: $(where "$d")"
				state=up; pause=60
				break
			fi
			say "не вышло: $n"
		done
		if [ "$state" != up ]; then
			say "следующая попытка через $pause с"
			sleep $pause
			pause=$((pause*2)); [ $pause -gt 300 ] && pause=300
		fi
	done
	[ "$state" = up ] && sleep 10
done
