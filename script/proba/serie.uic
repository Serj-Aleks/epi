[ "Num-js" index "-" ] -> 4
[ "угол" index "л" ] -> 4
[ "угол" index "x" ] -> 0
[ [ "A" "B" "C" ] index "B" ] -> 2
[ "a,b,c" quant "," ] -> [ "a" "b" "c" ]
[ "abc" quant "" ] -> [ "a" "b" "c" ]
[ [ "a" "b" ] combi "/" ] -> "a/b"
[ [] combi "/" ] -> ""
[ clear "  Ум  " ] -> "Ум"
[ "a-b-c" mutnt [ "-" "/" ] ] -> "a/b/c"
[ divrg "Угол" ] -> "УГОЛ"
[ nitxt 42 ] -> "42"
[ txnin "42" ] -> 42
[ txnin " 1.5 " ] -> 1.5
[ ( txnin "40" ) + 2 ] -> 42
[ txnin "abc" ] -> ? "не интерпретирует"
[ [ "a" 1 ] combi "/" ] -> ? "не интерпретирует"
