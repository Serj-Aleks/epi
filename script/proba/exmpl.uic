[ "2026-11-26" analg ''[0-9]{4}-[0-9]{2}-[0-9]{2}'' ] -> @true
[ "дата 2026-11-26" analg ''[0-9]{4}-[0-9]{2}-[0-9]{2}'' ] -> @false
[ "Gradus" analg ''\pL[\pL\pN_-]*'' ] -> @true
[ "Entries[[ [[JsonAny" analg ''\pL[\pL\pN_-]*'' ] -> @false
[ "см. [[Entries]] и [[JsonAny]]" total ''\[\[([^\]]+)\]\]'' ] -> [ [ "[[Entries]]" "Entries" ] [ "[[JsonAny]]" "JsonAny" ] ]
[ "ссылок нет" total ''\[\[([^\]]+)\]\]'' ] -> []
[ "a1b22c333" total ''[0-9]+'' ] -> [ [ "1" ] [ "22" ] [ "333" ] ]
[ "<b>жирный</b> текст" vecsl [ ''<[^>]*>'' "" ] ] -> "жирный текст"
[ "2026-11-26" vecsl [ ''([0-9]+)-([0-9]+)-([0-9]+)'' "$3.$2.$1" ] ] -> "26.11.2026"
[ Ampla.In : [ M N ] . Ampla : [ "[[" cnctn ( ( divrg Ampla.N ) cnctn "]]" ) ] ] -> @none
[ "см. [[Nun]] и [[num]]" vecsl [ ''\[\[([^\]]+)\]\]'' Ampla ] ] -> "см. [[NUN]] и [[NUM]]"
[ "abc" vecsl [ ''['' "" ] ] -> ? "шаблон не читается"
[ "abc" vecsl [ ''b'' Nemo ] ] -> ? "нужен фрейм с ролями In"
[ Nullum.In : [ M ] . Nullum : [ 5 ] ] -> @none
[ "abc" vecsl [ ''b'' Nullum ] ] -> ! "вернул не строку"
[ "abc" analg ''['' ] -> ? "не интерпретирует"
[ Lt.In : [ A B ] . Lt : [ Lt.A < Lt.B ] ] -> @none
[ Nomin.In : [ T ] . Nomin.Ex : Nomin ] -> @none
[ Nomin : [ Nomin.Nomin : [] . recur { In : ( ( Nomin.T vecsl [ ''(?ms)^```[^\n]*\n.*?^```[ \t]*$'' "" ] ) total ''\[\[([^\]]+)\]\]'' ) As : Nomin.M Corpus : [ Nomin.N : ( clear ( Nomin.M elmnt 2 ) ) . ( ( Nomin.N <> "" ) & ( non ( Nomin.N analg ''\pL[\pL\pN_?!*+~&|-]*'' ) ) ) -> mistk ( "ссылка «" cnctn ( ( Nomin.M elmnt 1 ) cnctn "» — не имя концепта: в [[ ]] только имя, проверьте скобки" ) ) . ( ( Nomin.N <> "" ) & ( ( Nomin.Nomin index Nomin.N ) = 0 ) ) -> [ Nomin.Nomin : ( Nomin.Nomin cnctn Nomin.N ) ] ] } . Nomin.Nomin : ( Nomin.Nomin order Lt ) ] ] -> @none
[ Nomin [ "Вызывает [[Entries]] и [[JsonAny]] (рекурсия), снова [[entries]].\n```\nx := m[[0]]\n```\n[[ Clavis ]] [[]] [[Flag]]\n" ] ] -> [ "Clavis" "Entries" "Flag" "JsonAny" ]
[ Nomin [ "Ссылок нет\n" ] ] -> []
[ Nomin [ "[[Zeta]] [[alpha]] [[Beta]]\n" ] ] -> [ "Beta" "Zeta" "alpha" ]
[ Nomin [ "см. [[Entries[[ [[JsonAny]] и [[Flag]]" ] ] -> ! "ссылка «[[Entries[[ [[JsonAny]]» — не имя концепта"
[ Nomin [ "[[A.B]]" ] ] -> ! "ссылка «[[A.B]]» — не имя концепта"
[ fixer [ Nomin [ "[[Beta]] [[ ]]" ] ] ] -> [ [ "Beta" ] @none ]
[ Nomin [ "[[A]]\n```\nx := \"``` [[0]] ```\"\n```\n[[B]]" ] ] -> [ "A" "B" ]
