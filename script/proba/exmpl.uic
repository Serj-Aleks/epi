[ "2026-11-26" aptus ''[0-9]{4}-[0-9]{2}-[0-9]{2}'' ] -> @true
[ "дата 2026-11-26" aptus ''[0-9]{4}-[0-9]{2}-[0-9]{2}'' ] -> @false
[ "Gradus" aptus ''\pL[\pL\pN_-]*'' ] -> @true
[ "Entries[[ [[JsonAny" aptus ''\pL[\pL\pN_-]*'' ] -> @false
[ "см. [[Entries]] и [[JsonAny]]" inven ''\[\[([^\]]+)\]\]'' ] -> [ [ "[[Entries]]" "Entries" ] [ "[[JsonAny]]" "JsonAny" ] ]
[ "ссылок нет" inven ''\[\[([^\]]+)\]\]'' ] -> []
[ "a1b22c333" inven ''[0-9]+'' ] -> [ [ "1" ] [ "22" ] [ "333" ] ]
[ "<b>жирный</b> текст" vicis [ ''<[^>]*>'' "" ] ] -> "жирный текст"
[ "2026-11-26" vicis [ ''([0-9]+)-([0-9]+)-([0-9]+)'' "$3.$2.$1" ] ] -> "26.11.2026"
[ Ampla.In : [ M N ] . Ampla : [ "[[" cnctn ( ( divrg Ampla.N ) cnctn "]]" ) ] ] -> @none
[ "см. [[Nun]] и [[num]]" vicis [ ''\[\[([^\]]+)\]\]'' Ampla ] ] -> "см. [[NUN]] и [[NUM]]"
[ "abc" vicis [ ''['' "" ] ] -> ? "шаблон не читается"
[ "abc" vicis [ ''b'' Nemo ] ] -> ? "нужен фрейм с ролями In"
[ Nullum.In : [ M ] . Nullum : [ 5 ] ] -> @none
[ "abc" vicis [ ''b'' Nullum ] ] -> ! "вернул не строку"
[ "abc" aptus ''['' ] -> ? "не интерпретирует"
[ Lt.In : [ A B ] . Lt : [ Lt.A < Lt.B ] ] -> @none
[ Nomina.In : [ T ] . Nomina.Ex : Nomina ] -> @none
[ Nomina : [ Nomina.Nomina : [] . recur { In : ( ( Nomina.T vicis [ ''(?s)```.*?```'' "" ] ) inven ''\[\[([^\]]+)\]\]'' ) As : Nomina.M Corpus : [ Nomina.N : ( clean ( Nomina.M elmnt 2 ) ) . ( ( Nomina.N <> "" ) & ( ( Nomina.Nomina index Nomina.N ) = 0 ) ) -> [ Nomina.Nomina : ( Nomina.Nomina cnctn Nomina.N ) ] ] } . Nomina.Nomina : ( Nomina.Nomina order Lt ) ] ] -> @none
[ Nomina [ "Вызывает [[Entries]] и [[JsonAny]] (рекурсия), снова [[entries]].\n```\nx := m[[0]]\n```\n[[ Clavis ]] [[]] [[Flag]]\n" ] ] -> [ "Clavis" "Entries" "Flag" "JsonAny" ]
[ Nomina [ "Ссылок нет\n" ] ] -> []
[ Nomina [ "[[Zeta]] [[alpha]] [[Beta]]\n" ] ] -> [ "Beta" "Zeta" "alpha" ]
