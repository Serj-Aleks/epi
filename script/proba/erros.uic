[ mistk "нет файла — создайте его" ] -> ! "нет файла — создайте его"
[ mistk ( "роль " cnctn "A" ) ] -> ! "роль A"
[ mistk 5 ] -> ? "текст ошибки — строка"
[ fixer [ 2 + 3 ] ] -> [ 5 @none ]
[ fixer [ mistk "плохо" ] ] -> [ @none "плохо" ]
[ fixer [ 1 / 0 ] ] -> [ @none "предикация «1 / 0» — «/» (arifm) не интерпретирует такие аргументы" ]
[ fixer [ jsnin "{ не json" ] ] -> [ @none "предикация «jsnin \"{ не json\"» — «jsnin» (assoc) не интерпретирует такие аргументы" ]
[ fixer [ fixer [ mistk "внутри" ] ] ] -> [ [ @none "внутри" ] @none ]
[ Probo.In : [ X ] . Probo : [ ( Probo.X < 0 ) -> mistk "X меньше нуля — подайте X >= 0" . Probo.X * 2 ] ] -> @none
[ Probo [ 4 ] ] -> 8
[ Probo [ -1 ] ] -> ! "X меньше нуля"
[ Duo.In : [ X ] . Duo : [ ( Probo [ Duo.X ] ) + 1 ] ] -> @none
[ Duo [ -1 ] ] -> ! "X меньше нуля"
[ fixer [ Duo [ -1 ] ] ] -> [ @none "X меньше нуля — подайте X >= 0" ]
[ Probo.X : 7 . fixer [ Probo [ -1 ] ] . Probo.X ] -> 7
