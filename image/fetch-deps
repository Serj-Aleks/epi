#!/usr/bin/env python3
"""EPI: дополнить образ пакетами, нужными Firefox (и другим программам).

Запускается на машине сборки после сборки образа. Берёт индекс репозитория
HaikuPorts, проходит по зависимостям от корневых пакетов и сверяет их с тем,
что реально лежит в собранном образе (а не с чьей-то установленной системой).
Недостающее: если пакет есть в репозитории сборки — в список
AddHaikuImageSystemPackages, иначе файл скачивается в epi-local/epi-packages.
Результат: epi-local/epi-packages.jam (подключается из UserBuildConfig).
Использование: fetch-deps [пакет ...]
По умолчанию корни — набор эталонной машины (image/packages-reference.txt,
проверено: Firefox на ней работает) за вычетом image/packages-exclude.txt;
так в образ попадает и то, что программы подгружают на ходу, не объявляя.
"""
import os, re, subprocess, sys, urllib.request

BASE = "https://eu.hpkg.haiku-os.org/haikuports/master/x86_64/current"
DEV = os.path.expanduser("~/haiku-dev")
HAIKU = os.path.join(DEV, "haiku")
GEN = os.path.join(HAIKU, "generated.x86_64")
LOCAL = os.path.join(DEV, "epi-local")
PK = os.path.join(LOCAL, "epi-packages")
ISO = os.path.join(GEN, "haiku-nightly-anyboot.iso")
HERE = os.path.dirname(os.path.abspath(__file__))
import fnmatch
EXCL = [l.strip() for l in open(os.path.join(HERE, "packages-exclude.txt"))
        if l.strip() and not l.startswith("#")]
def excluded(n):
    return any(fnmatch.fnmatch(n, e) for e in EXCL)
def reference_roots():
    excl = EXCL
    roots = []
    for l in open(os.path.join(HERE, "packages-reference.txt")):
        n = name_of(l.strip())
        if n and not any(fnmatch.fnmatch(n, e) for e in excl):
            roots.append(n)
    return roots
FROM_REFERENCE = not sys.argv[1:]
NAME_RE = re.compile(r"^([a-z0-9_]+)-[0-9][^-]*-[0-9]+-(?:x86_64|any)\.hpkg$")

def name_of(fn):
    m = NAME_RE.match(fn)
    return m.group(1) if m else None

# инструмент чтения индекса репозитория: версия для машины сборки (Linux),
# а не для Haiku; если её ещё нет, собираем
def find_tool():
    for root, _, files in os.walk(os.path.join(GEN, "objects", "linux")):
        p = os.path.join(root, "package_repo")
        if "package_repo" in files and os.access(p, os.X_OK):
            return p
tool = find_tool()
if not tool:
    subprocess.run(["jam", "-q", "<build>package_repo"], cwd=GEN, check=True)
    tool = find_tool()
if not tool:
    sys.exit("не найден package_repo для Linux в generated.x86_64/objects/linux")

os.makedirs(PK, exist_ok=True)
repo = os.path.join(LOCAL, "haikuports.repo")
urllib.request.urlretrieve(BASE + "/repo", repo)
# инструменты сборки для Linux используют свои библиотеки (libbe_build.so и др.)
libdirs = set()
for root, _, fs in os.walk(os.path.join(GEN, "objects", "linux")):
    if any(x.endswith("_build.so") for x in fs):
        libdirs.add(root)
env = dict(os.environ)
env["LD_LIBRARY_PATH"] = ":".join(sorted(libdirs) + [env.get("LD_LIBRARY_PATH", "")])
out = subprocess.run([tool, "list", "-v", "-f", repo], capture_output=True,
                     text=True, check=True, env=env).stdout

# индекс: пакет -> файл, требования; возможность -> пакет
files, requires, provider = {}, {}, {}
cur = None
for line in out.splitlines():
    s = line.strip()
    if s.startswith("name:"):
        cur = s.split()[1]; requires[cur] = []
    elif cur and s.startswith("provides:"):
        provider.setdefault(re.split(r"[\s=<>]", s[9:].strip())[0], []).append(cur)
    elif cur and s.startswith("requires:"):
        requires[cur].append(re.split(r"[\s=<>]", s[9:].strip())[0])
    elif cur and s.startswith("filename:"):
        files[cur] = s.split()[1]

# что в образе: имена пакетов, найденные в собранном образе
data = open(ISO, "rb").read()
in_image = set(m.decode() for m in re.findall(
    rb"([a-z0-9_]+)-[0-9][A-Za-z0-9_.~+]*-[0-9]+-(?:x86_64|any)\.hpkg", data))
# что добавили мы сами (не считается базой): наши файлы и всё, что прошлый
# запуск записал в epi-packages.jam (иначе база «плавает» от сборки к сборке)
JAM = os.path.join(LOCAL, "epi-packages.jam")
ours = set(filter(None, (name_of(f) for f in os.listdir(PK))))
if os.path.exists(JAM):
    for line in open(JAM):
        if line.startswith("# names:"):
            ours.update(line.split()[2:])
base = in_image - ours

# репозиторий сборки: эти пакеты добавляются по имени
build_repo = set()
for line in open(os.path.join(HAIKU, "build/jam/repositories/HaikuPorts/x86_64")):
    m = re.match(r"\s+([a-z0-9_]+)-[0-9]", line)
    if m: build_repo.add(m.group(1))

def pick(req):
    """Из нескольких пакетов, дающих одно и то же, берём уже имеющийся:
    сначала из образа, потом из наших пакетов (как на эталонной машине)."""
    cands = provider.get(req, [])
    for group in (base, ours):
        for c in cands:
            if c in group:
                return c
    return cands[0] if cands else None

ROOTS = reference_roots() if FROM_REFERENCE else sys.argv[1:]
# корни, которые и так есть в базовом образе, не добавляем (иначе — дубли)
ROOTS = [r for r in ROOTS if r not in base]
need, todo = [], list(ROOTS)
while todo:
    p = todo.pop(0)
    if p in need or (p in base and p not in ROOTS):
        continue
    if p not in requires:
        print("нет в репозитории:", p); continue
    need.append(p)
    for r in requires[p]:
        q = pick(r)
        # исключённое не попадает в образ и как зависимость
        if q and q not in need and q not in base and not excluded(q):
            todo.append(q)

by_name, by_file = [], []
for p in need:
    if p in build_repo:
        by_name.append(p); continue
    have = [f for f in os.listdir(PK) if name_of(f) == p]
    if have:
        by_file.append(os.path.join(PK, sorted(have)[-1])); continue
    fn = files[p]
    print("скачиваю", fn)
    urllib.request.urlretrieve(BASE + "/packages/" + fn, os.path.join(PK, fn))
    by_file.append(os.path.join(PK, fn))

with open(JAM, "w") as f:
    f.write("# создано image/fetch-deps\n")
    for i in range(0, len(need), 10):
        f.write("# names: " + " ".join(sorted(need)[i:i+10]) + "\n")
    # по одному имени в строке: jam не принимает слишком длинные строки
    if by_name:
        f.write("AddHaikuImageSystemPackages\n\t" + "\n\t".join(sorted(by_name)) + " ;\n")
    if by_file:
        f.write("AddFilesToHaikuImage system packages :\n\t"
                + "\n\t".join(sorted(by_file)) + " ;\n")
print("по имени (%d): %s" % (len(by_name), " ".join(sorted(by_name))))
print("файлами (%d): %s" % (len(by_file), " ".join(sorted(os.path.basename(x) for x in by_file))))
missing = [p for p in need if p not in in_image]
print("не хватало в образе (%d): %s" % (len(missing), " ".join(missing) or "-"))
