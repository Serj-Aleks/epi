diff --git a/data/config/boot/UserBootscript b/data/config/boot/UserBootscript
index f1dfc88b1a..cf49e7655a 100644
--- a/data/config/boot/UserBootscript
+++ b/data/config/boot/UserBootscript
@@ -22,3 +22,19 @@ done
 # To launch certain applications at boot-up, put links to those applications in
 # the above boot launch directory.
 
+
+#=====================================================================
+# EPI (APOTHEOS)
+# меню EPI создаётся при первой загрузке (ссылки на программы системы);
+# Deskbar к этому моменту уже запущен, поэтому перезапускаем его, чтобы он
+# назвал программы по меню
+if [ ! -d "$HOME/config/settings/deskbar/menu_entries" ]; then
+	/boot/home/config/non-packaged/bin/epi-menu
+	(hey Deskbar quit; sleep 2; /boot/system/Deskbar) >/dev/null 2>&1 &
+fi
+# сторож сети
+/boot/home/config/non-packaged/bin/epi-net &
+# панель (LaunchBox) поверх полосы, внизу справа; координаты под 1920x1080
+(for i in $(seq 1 30); do hey LaunchBox get Frame of Window 0 >/dev/null 2>&1 && break; sleep 1; done; hey LaunchBox set Feel of Window 0 to 6; hey LaunchBox set Frame of Window 0 to "BRect(1495,1035,1740,1082)") >/dev/null 2>&1 &
+# браузер: страница ожидания сети, затем ui.center
+/boot/home/config/non-packaged/bin/epi-browser &
diff --git a/data/system/boot/first_login/default_deskbar_items.sh b/data/system/boot/first_login/default_deskbar_items.sh
index 21e0cd8b08..21e0b5cea5 100755
