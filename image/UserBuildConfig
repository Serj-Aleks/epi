# EPI (APOTHEOS): настройки сборки образа Haiku.
# Кладётся в haiku/build/jam/UserBuildConfig.
# Рядом с деревом haiku ожидаются:
#   ../epi        — этот репозиторий;
#   ../epi-local  — epi-packages (пакеты не из репозитория сборки) и
#                   epi-settings (настройки с эталонной машины, без личных данных).

# Debian 12: offsetof в хост-инструментах
HOST_C++FLAGS += -include cstddef ;

# Размер образа (МБ): набор пакетов эталонной машины больше стандартного
HAIKU_IMAGE_SIZE = 2400 ;

local epi = [ FDirName $(HAIKU_TOP) .. epi ] ;
local epiLocal = [ FDirName $(HAIKU_TOP) .. epi-local ] ;

# Firefox и все его зависимости, которых нет в базовом образе.
# Файл создаёт image/fetchdeps (сверка с собранным образом).
local epiPackagesJam = [ FDirName $(epiLocal) epi-packages.jam ] ;
if [ Glob $(epiLocal) : epi-packages.jam ] {
	include $(epiPackagesJam) ;
}

# Скрыть демо и лишние программы
AddFilesToHaikuImage system settings : [ FDirName $(epi) system packages ] ;

# Программы и страница EPI
AddFilesToHaikuImage home config non-packaged bin
	: [ FDirName $(epi) net epi-net ] [ FDirName $(epi) menu epi-menu ]
	[ FDirName $(epi) shell epi-browser ] [ FDirName $(epi) tools epi-report ] ;

# Переключатель раскладок: US-International и Russian
AddFilesToHaikuImage home config settings : [ FDirName $(epi) settings Switcher ] ;

# Firefox: готовый профиль (без автономного режима и приветствий)
AddFilesToHaikuImage home config settings Mozilla Firefox
	: [ FDirName $(epi) firefox profiles.ini ] [ FDirName $(epi) firefox installs.ini ] ;
AddFilesToHaikuImage home config settings Mozilla Firefox epi.default
	: [ FDirName $(epi) firefox epi.default user.js ] ;

# Настройки: полоса, панель, файловый менеджер, раскладка, язык, мышь
CopyDirectoryToHaikuImage home config : [ FDirName $(epiLocal) epi-settings ]
	: settings ;

# Рабочий стол: логотип APOTHEOS в правом верхнем углу (как на эталонной машине).
# Картинка лежит в ~/Desktop, настройка фона — атрибут be:bgndimginfo папки.
AddFilesToHaikuImage home Desktop : [ FDirName $(epi) desktop apotheos-desktop.png ] ;
SEARCH on epi-desktop.rdef += [ FDirName $(epi) desktop ] ;
AddDirectoryToHaikuImage home Desktop : epi-desktop.rdef ;
