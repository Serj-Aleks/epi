#!/bin/sh
# EPI: браузер при загрузке — страница ожидания сети (сама переходит на
# ui.center, когда сеть есть) и окно над полосой Deskbar.
# профиль EPI задаётся явно: Firefox не выбирает профиль сам, а берёт этот,
# с настройками EPI (без автономного режима и без запоминания неудачных
# поисков адресов, иначе запущенный без сети Firefox не откроет ui.center)
firefox -profile "$HOME/config/settings/Mozilla/Firefox/epi.default" \
	file:///boot/home/epi/start.html &
for i in $(seq 1 60); do
	hey Firefox get Frame of Window 0 >/dev/null 2>&1 && break
	sleep 1
done
sleep 3
# координаты под 1920x1080
hey Firefox set Frame of Window 0 to "BRect(5,30,1914,1029)" >/dev/null 2>&1
