#!/bin/sh
# EPI: браузер при загрузке.
# Firefox запускается только когда сеть есть и ui.center отвечает: адрес
# сервера имён программа считывает один раз при запуске, и Firefox, запущенный
# до подключения Wi-Fi (на первой загрузке файла настроек сети ещё нет), не
# находит ни одного сайта. Пока сети нет — уведомление Haiku.
URL=https://ui.center/
PROFILE="$HOME/config/settings/Mozilla/Firefox/epi.default"

online() {
	for d in /dev/net/*/0; do
		ifconfig "$d" 2>/dev/null | grep -q 'Network:' && return 0
	done
	return 1
}

n=0
until online && wget -q --spider --timeout=5 "$URL"; do
	n=$((n+1))
	[ $n = 5 ] && notify --group APOTHEOS --title "Сеть не подключена" --timeout 60 \
		"Выберите сеть: значок сети внизу справа." >/dev/null 2>&1
	sleep 2
done

# профиль EPI задаётся явно (настройки EPI, без приветственных страниц)
firefox -profile "$PROFILE" "$URL" &
for i in $(seq 1 60); do
	hey Firefox get Frame of Window 0 >/dev/null 2>&1 && break
	sleep 1
done
sleep 3
# окно над полосой Deskbar; координаты под 1920x1080
hey Firefox set Frame of Window 0 to "BRect(5,30,1914,1029)" >/dev/null 2>&1
